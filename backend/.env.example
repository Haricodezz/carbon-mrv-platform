# =========================
# APP CONFIGURATION
# =========================
APP_NAME=Carbon MRV Platform
APP_ENV=development
ENVIRONMENT=development
DEBUG=True

# =========================
# SECURITY
# =========================
SECRET_KEY=<generate-a-strong-random-hex-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =========================
# DATABASE (PostgreSQL)
# Use your Supabase URL or a local PostgreSQL connection string
# =========================
DATABASE_URL=postgresql://user:password@host:5432/dbname

# =========================
# SUPABASE
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================
# FRONTEND / CORS
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# REDIS / CELERY
# Leave empty for local dev (tasks run synchronously in eager mode)
# For production, use a real Redis URL like redis://default:password@host:6379
# =========================
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# =========================
# RAZORPAY
# Leave as placeholders for mock mode during development
# =========================
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# =========================
# BLOCKCHAIN / WEB3
# =========================
CRYPTO_ENABLED=True
ENABLE_BLOCKCHAIN=true

BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

CARBON_TOKEN_CONTRACT_ADDRESS=your_amoy_contract_address
BLOCKCHAIN_CONTRACT_ADDRESS=your_amoy_contract_address
BLOCKCHAIN_CHAIN_ID=80002

PRIVATE_KEY=your_private_wallet_key


USDT_CONTRACT_ADDRESS=your_usdt_contract
USDC_CONTRACT_ADDRESS=your_usdc_contract
MASTER_WALLET_PRIVATE_KEY=your_private_wallet_key
MASTER_WALLET_ADDRESS=your_master_wallet_address
MIN_CONFIRMATIONS=12

# =========================
# SATELLITE / GIS / AI
# =========================
PLANETARY_COMPUTER_API_KEY=your_planetary_computer_api_key
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
NASA_GEDI_DATA_SOURCE=enabled

# =========================
# MACHINE LEARNING
# =========================
MODEL_PATH=ml/models/carbon_model.pkl
ENABLE_ADVANCED_BIOMASS=true
FRAUD_RISK_THRESHOLD=65

# =========================
# CERTIFICATES
# =========================
CERTIFICATE_STORAGE_PATH=storage/certificates/
ENABLE_CERTIFICATES=true

# =========================
# MARKETPLACE
# =========================
ENABLE_MARKETPLACE=true
DEFAULT_CREDIT_PRICE_INR=1000

# =========================
# ADMIN DEFAULTS
# Auto-created on first startup
# =========================
DEFAULT_ADMIN_EMAIL=admin@carbonmrv.com
DEFAULT_ADMIN_PASSWORD=StrongAdminPassword123

# =========================
# AUDITOR DEFAULTS
# Auto-created on first startup
# =========================
DEFAULT_AUDITOR_EMAIL=auditor@carbonmrv.com
DEFAULT_AUDITOR_PASSWORD=StrongAuditorPassword123

# =========================
# EMAIL / OTP (future)
# =========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO

# =========================
# FILE / SECURITY LIMITS
# =========================
MAX_UPLOAD_SIZE_MB=25

# =========================
# FEATURE FLAGS
# =========================
ENABLE_SATELLITE_VERIFICATION=true
ENABLE_POLYGON_VALIDATION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_FRAUD_ANALYTICS=true
